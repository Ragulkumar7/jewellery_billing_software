NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opal_line_jewelry
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Set only for the first deployment, then remove both bootstrap variables.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_ROLE=Manager
BOOTSTRAP_MASTER_EMAIL=master@opalline.in
BOOTSTRAP_MASTER_PASSWORD=replace-with-a-long-random-password
# Local UI development only. Never enable this outside NODE_ENV=development.
DEV_AUTH_BYPASS=false

# Shopify Admin GraphQL API. Keep the access token server-side only.
SHOPIFY_STORE_DOMAIN=opalline.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=replace_with_shopify_webhook_secret
# Public HTTPS base URL where the API is deployed (for Shopify webhook callbacks)
PUBLIC_API_URL=https://billing.opalline.in
